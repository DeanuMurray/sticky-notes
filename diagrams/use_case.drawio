<mxfile host="app.diagrams.net" version="29.6.4">
  <diagram id="use-case-sticky-notes" name="Use Case Diagram">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="boundary" value="Sticky Notes System"
          style="rounded=0;fillColor=none;strokeColor=#000000;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;html=1;"
          vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="720" height="740" as="geometry" />
        </mxCell>

        <!-- Actor: User -->
        <mxCell id="actor-user" value="User"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="60" height="100" as="geometry" />
        </mxCell>

        <!-- Use Cases -->
        <mxCell id="uc-list" value="View All Notes"
          style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc-add" value="Add Note"
          style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc-edit" value="Edit Note"
          style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="330" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc-delete" value="Delete Note"
          style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="330" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc-confirm" value="Confirm Deletion"
          style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="480" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Save to DB (included) -->
        <mxCell id="uc-save" value="Save to Database"
          style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="630" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Associations: User to primary use cases -->
        <mxCell id="a-user-list" edge="1" parent="1" source="actor-user" target="uc-list" style="endArrow=none;html=1;rounded=0;" />
        <mxCell id="a-user-add" edge="1" parent="1" source="actor-user" target="uc-add" style="endArrow=none;html=1;rounded=0;" />
        <mxCell id="a-user-edit" edge="1" parent="1" source="actor-user" target="uc-edit" style="endArrow=none;html=1;rounded=0;" />
        <mxCell id="a-user-delete" edge="1" parent="1" source="actor-user" target="uc-delete" style="endArrow=none;html=1;rounded=0;" />

        <!-- Include: Delete includes Confirm -->
        <mxCell id="inc-confirm" value="&lt;&lt;include&gt;&gt;" edge="1" parent="1" source="uc-delete" target="uc-confirm"
          style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" />

        <!-- Include: write operations include Save -->
        <mxCell id="inc-add-save" value="&lt;&lt;include&gt;&gt;" edge="1" parent="1" source="uc-add" target="uc-save"
          style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" />
        <mxCell id="inc-edit-save" value="&lt;&lt;include&gt;&gt;" edge="1" parent="1" source="uc-edit" target="uc-save"
          style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" />
        <mxCell id="inc-confirm-save" value="&lt;&lt;include&gt;&gt;" edge="1" parent="1" source="uc-confirm" target="uc-save"
          style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;" />

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
